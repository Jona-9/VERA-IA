# Envío real de correos (opcional). Copia a .env y completa; .env no se versiona.
# Sin VERAIA_MAIL_MODE=real, los avisos van solo a la bandeja de captura local (127.0.0.1:1025).
VERAIA_MAIL_MODE=real

VERAIA_SMTP_HOST=smtp.gmail.com
VERAIA_SMTP_PORT=587
VERAIA_SMTP_SECURITY=starttls      # none | starttls | ssl (ssl usa 465 por defecto)
VERAIA_SMTP_USER=tu-cuenta@ejemplo.com
VERAIA_SMTP_PASSWORD=               # en Gmail: contraseña de aplicación, no la de la cuenta

VERAIA_MAIL_FROM=tu-cuenta@ejemplo.com
VERAIA_MAIL_FROM_NAME=VERAIA Cobranza Preventiva

# Modo prueba: todos los avisos llegan a esta dirección (el original va en el asunto y en una cabecera).
VERAIA_MAIL_REDIRECT_TO=tu-correo-de-prueba@ejemplo.com
# Solo si data/portfolio.json tiene correos reales de clientes y quieres escribirles de verdad:
# VERAIA_MAIL_ALLOW_REAL_RECIPIENTS=1
